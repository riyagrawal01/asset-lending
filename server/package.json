{
  "name": "asset-lending-server",
  "version": "1.0.0",
  "description": "Asset Lending API server",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand --forceExit"
  },
